      <aliases enabled='yes' />
      <column caption='Review performance score' datatype='integer' name='[Calculation_1426126751490048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1426126753382401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;Luxery&quot; ELSEIF [Price]&gt;150 THEN &quot;Standard&quot; ELSE &quot;Budget&quot; END' />
      </column>
      <column caption='Count of Hotels' datatype='integer' name='[Calculation_1426126756229122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1426126760214531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;TODAY() THEN &quot;Active Host&quot; ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='review category ' datatype='string' name='[Calculation_1426126760992772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Number Of Reviews]&gt;=100 THEN &quot;Highly reviewed&quot; ELSE &quot;Less reviewed&quot; &#13;&#10;END' />
      </column>
      <column caption='Price Filter category' datatype='string' name='[Calculation_1426126762795014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1426126761771013]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='New Host Sinc' datatype='date' name='[Calculation_1426126769602568]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Score rating(new)' datatype='string' name='[Calculation_1426126771863561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column caption='AirBnB_NYC' datatype='table' name='[__tableau_internal_object_id__].[AirBnB!NYC_3EE829D7AAE145FDA22A37623CBF3FDF]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
